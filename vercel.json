{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": ["hnd1"],
  "rewrites": [
    { "source": "/s/:code", "has": [{ "type": "query", "key": "lang", "value": "en" }], "destination": "/api/gacha?op=share-page&code=:code&lang=en" },
    { "source": "/s/:code", "destination": "/api/gacha?op=share-page&code=:code" },
    { "source": "/auth/google", "destination": "/api/gacha?op=google-callback" }
  ],
  "headers": [
    {
      "source": "/(stickers|audio)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/(og|icon-192|icon-512|icon-maskable-512|apple-touch-icon|favicon-32)\\.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/((?!api/|auth/|s/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://yi-niao-stickers.yi-niao.workers.dev; connect-src 'self' https://accounts.google.com/gsi/ https://yi-niao-stickers.yi-niao.workers.dev; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/(api|auth|s)/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
